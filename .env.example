# Required: Cursor user or team service-account key
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Required — no hardcoded defaults
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# Optional
DEFAULT_BRANCH=main
CURSOR_MODEL=composer-2.5
MAX_FIX_ITERATIONS=3

# Agents stay OFF until explicitly enabled (safe default: false)
SENTRY_AUTO_FIX_ENABLED=false

# Host project instructions for agents (or use PROJECT_CONTEXT_PATH=./project-context.md)
PROJECT_CONTEXT=Project: MyApp — describe language, test command, lint command, architecture rules.

# Optional: write summary JSON
# RESULT_PATH=./sentry-fix-result.json
# RESULT_FULL=1

# GitHub token enables fingerprint dedupe (required in CI)
# GH_TOKEN=ghp_...
# DEDUPE_FORCE=1
